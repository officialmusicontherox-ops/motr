# Copy to .env for local dev. In production these are set in the Vercel
# dashboard (Project → Settings → Environment Variables), never committed.

# --- Database (Neon Postgres) -------------------------------------------
# Use the POOLED connection string in production — serverless functions open
# far more connections than a direct one can hold.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Where the app lives -------------------------------------------------
# Must be the real public origin in production. Used to build OAuth redirect
# and Stripe return URLs, so a wrong value breaks sign-in and checkout.
APP_URL="https://app.musicontherox.com"

# --- Spotify -------------------------------------------------------------
# The redirect URI must be registered verbatim in the Spotify dashboard.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="https://app.musicontherox.com/api/auth/spotify/callback"

# --- Google (curator sign-in) --------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://app.musicontherox.com/api/auth/google/callback"

# --- Stripe (artist submission fee) --------------------------------------
# LIVE keys take real money. Use sk_test_/pk_test_ anywhere you might
# actually complete a checkout while testing.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_ARTIST_FEE_PRODUCT_ID=""
# From Stripe → Developers → Webhooks, after pointing one at
# https://app.musicontherox.com/api/payments/webhook
STRIPE_WEBHOOK_SECRET=""

# --- Email (Resend) ------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="MOTR <hello@musicontherox.com>"
EMAIL_REPLY_TO="officialmusicontherox@gmail.com"

# --- Admin dashboard -----------------------------------------------------
# Signs the admin session cookie. Generate a fresh one for production:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=""
